{
  "manifest_version": 3,
  "name": "HUFS 종강시계 v2",
  "description": "한국외대 종강 D-Day, 학식, 공지사항을 새 탭에서 바로 확인하세요.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://hufs-clock-api.vercel.app/*"
  ]
}