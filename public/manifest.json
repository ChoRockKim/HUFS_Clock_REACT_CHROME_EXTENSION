{
  "manifest_version": 3,
  "name": "HUFS 종강시계",
  "description": "한국외대 종강 까지 남은 시간을 보여주는 확장 프로그램입니다. 새 탭을 켜보세요!",
  "version": "2.1.0",
  "offline_enabled": true,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://hufs-clock-api.vercel.app/*"
  ]
}